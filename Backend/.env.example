PORT=5000
MONGO_URI=mongodb://localhost:27017/printfastx
JWT_SECRET=your_jwt_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Frontend URL (used in QR codes and mail links)
FRONTEND_URL=http://localhost:5173

# Admin Credentials
ADMIN_EMAIL=admin@printfastx.in
ADMIN_PASSWORD=admin123

# File Storage Configuration (local or s3)
STORAGE_TYPE=local

# AWS S3 Storage Credentials (Required only if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# SMTP Mail Server Credentials (Required for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="PrintFastX" <noreply@printfastx.in>
